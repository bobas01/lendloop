# --- Next.js / Clerk ---
# Récupérer dans le dashboard Clerk (API Keys)
# Ou : npx clerk init --framework next -y --accountless
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# --- Convex ---
# Rempli automatiquement après `npx convex dev`
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site
# À définir aussi dans le dashboard Convex (Settings > Environment Variables)
CLERK_JWT_ISSUER_DOMAIN=https://verb-noun-00.clerk.accounts.dev

# --- n8n / webhooks ---
# Même secret côté Convex (`npx convex env set`) et n8n (LENDLOOP_HMAC_SECRET)
N8N_SHARED_SECRET=change-me-shared-hmac-secret
N8N_WEBHOOK_SECRET=change-me-shared-hmac-secret
# Démo locale sans tunnel : log://local
# Prod / n8n Cloud / ngrok : URL publique du webhook
N8N_WEBHOOK_URL=log://local
